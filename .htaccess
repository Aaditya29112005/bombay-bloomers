DirectoryIndex index.html
Options -Indexes

RewriteEngine On
# Force HTTPS and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# Old WordPress page addresses -> sections of the new site
RewriteRule ^food_menus/?$ /#menu [NE,R=301,L]
RewriteRule ^drinks_menu/?$ /#menu [NE,R=301,L]
RewriteRule ^locations/?$ /#visit [NE,R=301,L]
RewriteRule ^order-online/?$ /#order [NE,R=301,L]
# Temporary until a privacy page is added
RewriteRule ^privacy/?$ / [R=302,L]

# Keep the repo README private
RewriteRule ^README\.md$ - [F,L]
